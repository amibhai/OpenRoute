{
  "manifest_version": 3,
  "name": "OpenRoute — Unblock & Route",
  "version": "0.3.0",
  "description": "Detects blocked sites, diagnoses how they're blocked, and auto-routes only those domains down a failover ladder (Secure DNS → proxy → Tor) at full speed. Free and open source.",
  "browser_specific_settings": {
    "gecko": { "id": "openroute@openroute.app", "strict_min_version": "115.0" }
  },
  "permissions": [
    "webNavigation",
    "storage",
    "activeTab",
    "proxy",
    "alarms",
    "nativeMessaging"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "scripts": ["background.js"],
    "type": "module"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "OpenRoute",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
