# Normalize line endings in the repo; keep scripts runnable on their platforms.
* text=auto
*.sh text eol=lf
*.bash text eol=lf
*.go text eol=lf
*.ps1 text eol=crlf
*.png binary
*.ico binary
*.zip binary
test/server/fakes/* text eol=lf

# What ships in the extension is checked out with LF everywhere, so a build
# from any clone (Windows included) matches the release zips byte for byte.
*.js text eol=lf
*.mjs text eol=lf
*.json text eol=lf
*.html text eol=lf
*.css text eol=lf
*.md text eol=lf
*.yml text eol=lf
